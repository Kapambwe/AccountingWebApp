{
  "formId": "sars-irp6",
  "formName": "SARS IRP6 - Return for Payment of Provisional Tax",
  "sections": [
    {
      "sectionTitle": "1. TAXPAYER & PERIOD DETAILS",
      "fields": [
        {
          "id": "taxReferenceNumber",
          "label": "Tax Reference Number:",
          "type": "text",
          "required": true,
          "bindingProperty": "Customer.TaxReferenceNumber"
        },
        {
          "id": "provisionalPeriod",
          "label": "Provisional Period (Period 1 / Period 2):",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.provisionalPeriod"
        },
        {
          "id": "taxYear",
          "label": "Tax Year:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.taxYear"
        }
      ]
    },
    {
      "sectionTitle": "2. ESTIMATE OF TAXABLE INCOME",
      "fields": [
        {
          "id": "estimatedTaxableIncome",
          "label": "Estimated Total Taxable Income for the Year (ZAR):",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.estimatedTaxableIncome"
        },
        {
          "id": "calculatedTax",
          "label": "Calculated Tax Liability on Estimated Income:",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.calculatedTax"
        },
        {
          "id": "lessEmployeesTax",
          "label": "Less: Employees Tax Deducted (PAYE) for this period:",
          "type": "number",
          "required": false,
          "bindingProperty": "SchemaLocal.lessEmployeesTax"
        },
        {
          "id": "lessPriorProvisionalPayments",
          "label": "Less: Prior Provisional Tax Payments for this Tax Year (Period 1 payment if this is Period 2):",
          "type": "number",
          "required": false,
          "bindingProperty": "SchemaLocal.lessPriorProvisionalPayments"
        },
        {
          "id": "netProvisionalTaxDue",
          "label": "Net Provisional Tax Amount Due / Payable:",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.netProvisionalTaxDue"
        }
      ]
    }
  ]
}
