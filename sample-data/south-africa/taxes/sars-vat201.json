{
  "formId": "sars-vat201",
  "formName": "SARS VAT201 - Vendor Declaration Form",
  "sections": [
    {
      "sectionTitle": "1. VENDOR IDENTIFICATION & PERIOD",
      "fields": [
        {
          "id": "vatRegistrationNumber",
          "label": "VAT Registration Number (Starts with '4'):",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.vatRegistrationNumber"
        },
        {
          "id": "vendorTradingName",
          "label": "Trading Name:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.vendorTradingName"
        },
        {
          "id": "taxPeriod",
          "label": "Tax Period (e.g., 2026/03):",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.taxPeriod"
        }
      ]
    },
    {
      "sectionTitle": "2. OUTPUT TAX (Supplies Made)",
      "fields": [
        {
          "id": "standardRatedSupplies",
          "label": "Standard Rated Supplies (Excluding VAT) (ZAR):",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.standardRatedSupplies"
        },
        {
          "id": "outputTaxAmount",
          "label": "Output Tax Calculated (15%):",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.outputTaxAmount"
        },
        {
          "id": "zeroRatedSupplies",
          "label": "Zero Rated Supplies:",
          "type": "number",
          "required": false,
          "bindingProperty": "SchemaLocal.zeroRatedSupplies"
        },
        {
          "id": "exemptSupplies",
          "label": "Exempt Supplies:",
          "type": "number",
          "required": false,
          "bindingProperty": "SchemaLocal.exemptSupplies"
        }
      ]
    },
    {
      "sectionTitle": "3. INPUT TAX (Capital and Goods/Services Imported or Capital Domestic)",
      "fields": [
        {
          "id": "capitalGoodsCapitalPurchases",
          "label": "Input Tax: Capital Goods/Services Domestic (ZAR):",
          "type": "number",
          "required": false,
          "bindingProperty": "SchemaLocal.capitalGoodsCapitalPurchases"
        },
        {
          "id": "otherGoodsDomestic",
          "label": "Input Tax: Other Goods/Services Domestic:",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.otherGoodsDomestic"
        },
        {
          "id": "importedGoodsTax",
          "label": "Input Tax: Goods Imported:",
          "type": "number",
          "required": false,
          "bindingProperty": "SchemaLocal.importedGoodsTax"
        },
        {
          "id": "totalInputTax",
          "label": "Total Input Tax Deduction Amount:",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.totalInputTax"
        }
      ]
    },
    {
      "sectionTitle": "4. VAT CALCULATION SUMMARY",
      "fields": [
        {
          "id": "netVatPayableRefundable",
          "label": "Net VAT Due Payable / (Refundable) (Output minus Input):",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.netVatPayableRefundable"
        }
      ]
    }
  ]
}
