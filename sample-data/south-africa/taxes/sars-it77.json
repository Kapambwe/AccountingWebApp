{
  "formId": "sars-it77",
  "formName": "SARS IT77 - Application for Registration as an Income Taxpayer (Individual)",
  "sections": [
    {
      "sectionTitle": "1. PERSONAL PARTICULARS",
      "fields": [
        {
          "id": "surname",
          "label": "Surname:",
          "type": "text",
          "required": true,
          "bindingProperty": "Customer.Name"
        },
        {
          "id": "firstNames",
          "label": "First Names:",
          "type": "text",
          "required": true,
          "bindingProperty": "Customer.Name"
        },
        {
          "id": "dateOfBirth",
          "label": "Date of Birth (YYYY-MM-DD):",
          "type": "date",
          "required": true,
          "bindingProperty": "SchemaLocal.dateOfBirth"
        },
        {
          "id": "saIdNumber",
          "label": "South African Identity Number:",
          "type": "text",
          "required": false,
          "bindingProperty": "SchemaLocal.saIdNumber"
        },
        {
          "id": "passportNumber",
          "label": "Passport Number (If non-SA citizen):",
          "type": "text",
          "required": false,
          "bindingProperty": "SchemaLocal.passportNumber"
        },
        {
          "id": "passportCountry",
          "label": "Passport Country of Issue:",
          "type": "text",
          "required": false,
          "bindingProperty": "SchemaLocal.passportCountry"
        }
      ]
    },
    {
      "sectionTitle": "2. CONTACT & RESIDENTIAL SETTINGS",
      "fields": [
        {
          "id": "cellphoneNumber",
          "label": "Mobile Phone Number:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.cellphoneNumber"
        },
        {
          "id": "emailAddress",
          "label": "Email Address:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.emailAddress"
        },
        {
          "id": "residentialAddressText",
          "label": "Full Residential Address Lines:",
          "type": "textarea",
          "required": true,
          "bindingProperty": "SchemaLocal.residentialAddressText"
        },
        {
          "id": "residentialPostalCode",
          "label": "Postal Code:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.residentialPostalCode"
        }
      ]
    },
    {
      "sectionTitle": "3. EMPLOYMENT & INCOME PARAMETERS",
      "fields": [
        {
          "id": "employmentStatus",
          "label": "Employment Status (Employed / Unemployed / Sole Proprietor / Pensioner):",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.employmentStatus"
        },
        {
          "id": "dateEmployed",
          "label": "Date of Current Employment / Commencement of Trade:",
          "type": "date",
          "required": false,
          "bindingProperty": "SchemaLocal.dateEmployed"
        },
        {
          "id": "estimatedAnnualIncome",
          "label": "Estimated Annual Gross Income (ZAR):",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.estimatedAnnualIncome"
        }
      ]
    },
    {
      "sectionTitle": "4. DECLARATION",
      "fields": [
        {
          "id": "applicantSignatureText",
          "label": "Signature Name confirmation:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.applicantSignatureText"
        },
        {
          "id": "submissionDate",
          "label": "Date:",
          "type": "date",
          "required": true,
          "bindingProperty": "SchemaLocal.submissionDate"
        }
      ]
    }
  ]
}
