{
  "formId": "sars-itr14",
  "formName": "SARS ITR14 - Income Tax Return for Companies",
  "sections": [
    {
      "sectionTitle": "1. COMPANY PARTICULARS",
      "fields": [
        {
          "id": "companyTaxReferenceNumber",
          "label": "Company Tax Reference Number:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.companyTaxReferenceNumber"
        },
        {
          "id": "cipcRegistrationNumber",
          "label": "CIPC Registration Number:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.cipcRegistrationNumber"
        },
        {
          "id": "registeredName",
          "label": "Registered Name:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.registeredName"
        },
        {
          "id": "financialYearEnd",
          "label": "Financial Year-End Date (YYYY-MM-DD):",
          "type": "date",
          "required": true,
          "bindingProperty": "SchemaLocal.financialYearEnd"
        }
      ]
    },
    {
      "sectionTitle": "2. COMPANY CLASSIFICATION",
      "fields": [
        {
          "id": "isSmallBusinessCorporation",
          "label": "Does the company qualify as a Small Business Corporation (SBC) under Sec 12E? (Yes / No):",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.isSmallBusinessCorporation"
        },
        {
          "id": "isDormant",
          "label": "Was the company dormant during this year of assessment? (Yes / No):",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.isDormant"
        }
      ]
    },
    {
      "sectionTitle": "3. FINANCIAL INFORMATION SUMMARY",
      "fields": [
        {
          "id": "grossRevenue",
          "label": "Gross Sales / Turnover (ZAR):",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.grossRevenue"
        },
        {
          "id": "costOfSales",
          "label": "Cost of Sales:",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.costOfSales"
        },
        {
          "id": "accountingProfitLoss",
          "label": "Net Profit or Loss before Tax (Accounting):",
          "type": "number",
          "required": true,
          "bindingProperty": "SchemaLocal.accountingProfitLoss"
        }
      ]
    },
    {
      "sectionTitle": "4. PUBLIC OFFICER DECLARATION",
      "fields": [
        {
          "id": "publicOfficerName",
          "label": "Full Name of Public Officer:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.publicOfficerName"
        },
        {
          "id": "signature",
          "label": "Signature of Public Officer:",
          "type": "text",
          "required": true,
          "bindingProperty": "Customer.Name"
        }
      ]
    }
  ]
}
