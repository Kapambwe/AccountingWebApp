{
  "formId": "sars-it77tr",
  "formName": "SARS IT77TR - Application for Registration as an Income Taxpayer (Trust)",
  "sections": [
    {
      "sectionTitle": "1. TRUST CORE PROFILE",
      "fields": [
        {
          "id": "trustName",
          "label": "Registered Name of the Trust:",
          "type": "text",
          "required": true,
          "bindingProperty": "Customer.Name"
        },
        {
          "id": "masterReferenceNumber",
          "label": "Master of the High Court Reference Number (e.g., IT1234/2026):",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.masterReferenceNumber"
        },
        {
          "id": "trustType",
          "label": "Type of Trust (Family Trust / Testamentary Trust / Inter Vivos / Special Trust):",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.trustType"
        },
        {
          "id": "dateEstablished",
          "label": "Date Trust Created / Registered (YYYY-MM-DD):",
          "type": "date",
          "required": true,
          "bindingProperty": "SchemaLocal.dateEstablished"
        }
      ]
    },
    {
      "sectionTitle": "2. MAIN TRUSTEE / REPRESENTATIVE TAXPAYER",
      "fields": [
        {
          "id": "mainTrusteeFullName",
          "label": "Full Legal Name of Representative Trustee / Administrator:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.mainTrusteeFullName"
        },
        {
          "id": "mainTrusteeIdNo",
          "label": "Representative ID / Passport Number:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.mainTrusteeIdNo"
        },
        {
          "id": "representativeEmail",
          "label": "Representative Contact Email Address:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.representativeEmail"
        }
      ]
    },
    {
      "sectionTitle": "3. DECLARATION OF AUTHORIZATION",
      "fields": [
        {
          "id": "trusteeSignature",
          "label": "Signature of Authorised Trustee:",
          "type": "text",
          "required": true,
          "bindingProperty": "SchemaLocal.trusteeSignature"
        },
        {
          "id": "executionDate",
          "label": "Date of Declaration Execution:",
          "type": "date",
          "required": true,
          "bindingProperty": "SchemaLocal.executionDate"
        }
      ]
    }
  ]
}
