{
  "schemaId": "sars-itr12-2025",
  "authorityId": "za-sars",
  "taxTypeId": "individual-income-tax",
  "yearOfAssessment": 2025,
  "displayName": "Income Tax Return for Individuals (ITR12) 2025",
  "isActive": true,
  "tenantId": "demo",
  "wizardQuestions": [
    {
      "questionId": "is-tax-practitioner",
      "prompt": "Mark with an 'X' if you are completing the return as a Tax Practitioner.",
      "answerType": "MarkWithX",
      "group": "Standard",
      "displayOrder": 10
    },
    {
      "questionId": "is-non-resident",
      "prompt": "Mark with an 'X' if you are a foreign national and not an RSA Tax-Resident.",
      "answerType": "MarkWithX",
      "group": "Standard",
      "displayOrder": 20
    },
    {
      "questionId": "received-irp5",
      "prompt": "Did you receive income reflected on an IRP5/IT3(a) Employee Tax Certificate?",
      "answerType": "YesNo",
      "group": "Standard",
      "displayOrder": 30,
      "defaultAnswer": "No"
    },
    {
      "questionId": "had-medical",
      "prompt": "Did you incur any medical expenditure (including medical scheme contributions made by you)?",
      "answerType": "YesNo",
      "group": "Standard",
      "displayOrder": 40,
      "defaultAnswer": "No"
    },
    {
      "questionId": "had-retirement",
      "prompt": "Did you make any retirement annuity contributions for the benefit of yourself?",
      "answerType": "YesNo",
      "group": "Standard",
      "displayOrder": 50,
      "defaultAnswer": "No"
    },
    {
      "questionId": "had-travel-allowance",
      "prompt": "Did you receive a travel allowance / use of motor vehicle?",
      "answerType": "YesNo",
      "group": "Standard",
      "displayOrder": 60,
      "defaultAnswer": "No"
    },
    {
      "questionId": "had-investment-income",
      "prompt": "Did you receive interest, dividends or REIT income?",
      "answerType": "YesNo",
      "group": "Standard",
      "displayOrder": 70,
      "defaultAnswer": "No"
    },
    {
      "questionId": "had-rental-income",
      "prompt": "Did you derive income from letting fixed property?",
      "answerType": "YesNo",
      "group": "Standard",
      "displayOrder": 80,
      "defaultAnswer": "No"
    },
    {
      "questionId": "had-trust-income",
      "prompt": "Mark with an 'X' if you received or became entitled to any income as a beneficiary of a Trust.",
      "answerType": "MarkWithX",
      "group": "Standard",
      "displayOrder": 90
    },
    {
      "questionId": "had-donations",
      "prompt": "Do you want to claim donations to approved Public Benefit Organisations (s18A)?",
      "answerType": "YesNo",
      "group": "Standard",
      "displayOrder": 100,
      "defaultAnswer": "No"
    },
    {
      "questionId": "had-capital-gain",
      "prompt": "Did you have any capital gains or losses (local)?",
      "answerType": "YesNo",
      "group": "Standard",
      "displayOrder": 110,
      "defaultAnswer": "No"
    }
  ],
  "sections": [
    {
      "sectionId": "taxpayer-info",
      "displayName": "Taxpayer Information",
      "displayOrder": 10,
      "isAlwaysVisible": true,
      "fields": [
        { "fieldId": "taxRefNo", "label": "Taxpayer Ref No.", "dataType": "Text", "isRequired": true, "displayOrder": 10, "validationRegex": "^[0-9]{10}$", "regexFailureMessage": "Tax reference number must be 10 digits." },
        { "fieldId": "surname", "label": "Surname", "dataType": "Text", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "firstNames", "label": "First Names", "dataType": "Text", "isRequired": true, "displayOrder": 30 },
        { "fieldId": "idNumber", "label": "South African ID No.", "dataType": "Text", "isRequired": false, "displayOrder": 40, "validationRegex": "^[0-9]{13}$", "regexFailureMessage": "South African ID must be 13 digits." },
        { "fieldId": "dateOfBirth", "label": "Date of Birth", "dataType": "Date", "isRequired": true, "displayOrder": 50 }
      ]
    },
    {
      "sectionId": "tax-practitioner-details",
      "displayName": "Tax Practitioner Details",
      "displayOrder": 20,
      "isAlwaysVisible": false,
      "visibilityRule": {
        "logic": "All",
        "conditions": [
          { "questionId": "is-tax-practitioner", "operator": "IsTruthy", "expectedValue": "X" }
        ]
      },
      "helperPanelText": "If this declaration is not made by a Tax Practitioner, change your 'Is this declaration made by a Tax Practitioner?' answer to 'No' on the first page of this return.",
      "fields": [
        {
          "fieldId": "practitionerRegNo",
          "label": "Tax Practitioner Registration No.",
          "dataType": "Text",
          "isRequired": true,
          "displayOrder": 10,
          "formatHint": "PR followed by 7 alpha (A-Z) and / or numeric (0-9) characters.",
          "validationRegex": "^PR[A-Z0-9]{7}$",
          "regexFailureMessage": "Tax Practitioner Registration No. you have entered does not seem to be valid. Please ensure that it is correct. HINTS: Only alpha and numeric digits may be used. The first two digits must be PR followed by 7 alpha (A-Z) and / or numeric (0-9) characters."
        },
        { "fieldId": "practitionerTel", "label": "Tax Practitioner Tel No.", "dataType": "Phone", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "practitionerEmail", "label": "Tax Practitioner Email", "dataType": "Email", "isRequired": true, "displayOrder": 30, "validationRegex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", "regexFailureMessage": "Enter a valid email address." },
        { "fieldId": "practitionerEmailConfirm", "label": "Confirm Tax Practitioner Email", "dataType": "Email", "isRequired": true, "displayOrder": 40, "mustMatchFieldId": "practitionerEmail" },
        { "fieldId": "practitionerNoEmail", "label": "Mark here with an 'X' if you declare that you do not have an email address.", "dataType": "Boolean", "isRequired": false, "displayOrder": 50 }
      ]
    },
    {
      "sectionId": "irp5-employment",
      "displayName": "Employee Tax Certificate Information (IRP5/IT3(a))",
      "displayOrder": 30,
      "visibilityRule": {
        "conditions": [{ "questionId": "received-irp5", "operator": "Equals", "expectedValue": "Yes" }]
      },
      "fields": [
        { "fieldId": "employerPayeRef", "label": "Employer PAYE Ref No.", "dataType": "Text", "isRequired": true, "displayOrder": 10, "validationRegex": "^7[0-9]{9}$", "regexFailureMessage": "PAYE reference must start with 7 and be 10 digits." },
        { "fieldId": "incomeSourceCode", "label": "Income Source Code", "dataType": "Text", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "grossEmploymentIncome", "label": "Gross Employment Income (3601)", "dataType": "Currency", "isRequired": true, "displayOrder": 30 },
        { "fieldId": "payeWithheld", "label": "PAYE Tax Withheld (4102)", "dataType": "Currency", "isRequired": true, "displayOrder": 40 }
      ]
    },
    {
      "sectionId": "medical-deductions",
      "displayName": "Medical Deductions",
      "displayOrder": 40,
      "visibilityRule": {
        "conditions": [{ "questionId": "had-medical", "operator": "Equals", "expectedValue": "Yes" }]
      },
      "fields": [
        { "fieldId": "medicalSchemeName", "label": "Medical Scheme Name", "dataType": "Text", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "medicalDependants", "label": "Number of dependants on medical scheme", "dataType": "Number", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "medicalContributions", "label": "Total contributions paid to medical scheme (4040)", "dataType": "Currency", "isRequired": true, "displayOrder": 30 },
        { "fieldId": "medicalOutOfPocket", "label": "Qualifying medical expenses paid out-of-pocket (4020)", "dataType": "Currency", "isRequired": false, "displayOrder": 40 }
      ]
    },
    {
      "sectionId": "retirement-contributions",
      "displayName": "Retirement Annuity Contributions",
      "displayOrder": 50,
      "visibilityRule": {
        "conditions": [{ "questionId": "had-retirement", "operator": "Equals", "expectedValue": "Yes" }]
      },
      "fields": [
        { "fieldId": "raFundName", "label": "Retirement Annuity Fund Name", "dataType": "Text", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "raMembershipNo", "label": "Membership / Policy No.", "dataType": "Text", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "raContributions", "label": "Total contributions paid in this year (4006)", "dataType": "Currency", "isRequired": true, "displayOrder": 30 }
      ]
    },
    {
      "sectionId": "travel-expenses",
      "displayName": "Travel Expenses against Allowance",
      "displayOrder": 60,
      "visibilityRule": {
        "conditions": [{ "questionId": "had-travel-allowance", "operator": "Equals", "expectedValue": "Yes" }]
      },
      "fields": [
        { "fieldId": "vehicleMakeModel", "label": "Vehicle Make / Model", "dataType": "Text", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "vehicleRegNo", "label": "Vehicle Registration No.", "dataType": "Text", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "openingOdometer", "label": "Opening Odometer (km)", "dataType": "Number", "isRequired": true, "displayOrder": 30 },
        { "fieldId": "closingOdometer", "label": "Closing Odometer (km)", "dataType": "Number", "isRequired": true, "displayOrder": 40 },
        { "fieldId": "businessKilometres", "label": "Business Kilometres travelled", "dataType": "Number", "isRequired": true, "displayOrder": 50 }
      ]
    },
    {
      "sectionId": "investment-income",
      "displayName": "Investment Income (Interest, Dividends, REIT)",
      "displayOrder": 70,
      "visibilityRule": {
        "conditions": [{ "questionId": "had-investment-income", "operator": "Equals", "expectedValue": "Yes" }]
      },
      "fields": [
        { "fieldId": "localInterest", "label": "Local Interest received (4201)", "dataType": "Currency", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "localDividends", "label": "Local Taxable Dividends (4238)", "dataType": "Currency", "isRequired": false, "displayOrder": 20 },
        { "fieldId": "reitDistributions", "label": "REIT Distributions (4214)", "dataType": "Currency", "isRequired": false, "displayOrder": 30 }
      ]
    },
    {
      "sectionId": "rental-income",
      "displayName": "Local Rental Income",
      "displayOrder": 80,
      "visibilityRule": {
        "conditions": [{ "questionId": "had-rental-income", "operator": "Equals", "expectedValue": "Yes" }]
      },
      "fields": [
        { "fieldId": "propertyAddress", "label": "Property Address", "dataType": "LongText", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "rentalReceived", "label": "Gross Rental Income received", "dataType": "Currency", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "rentalExpenses", "label": "Total Allowable Expenses", "dataType": "Currency", "isRequired": true, "displayOrder": 30 },
        { "fieldId": "rentalProfitLoss", "label": "Net Profit / (Loss)", "dataType": "Currency", "isRequired": false, "displayOrder": 40, "helperText": "Calculated automatically from Income minus Expenses." }
      ]
    },
    {
      "sectionId": "trust-income",
      "displayName": "Trust Income",
      "displayOrder": 90,
      "visibilityRule": {
        "conditions": [{ "questionId": "had-trust-income", "operator": "IsTruthy", "expectedValue": "X" }]
      },
      "fields": [
        { "fieldId": "trustName", "label": "Trust Name", "dataType": "Text", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "trustIncomeTaxRef", "label": "Trust Income Tax Reference No.", "dataType": "Text", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "trustDistribution", "label": "Distribution received / vested in you", "dataType": "Currency", "isRequired": true, "displayOrder": 30 }
      ]
    },
    {
      "sectionId": "postal-address",
      "displayName": "Postal Address Details",
      "displayOrder": 100,
      "isAlwaysVisible": true,
      "fields": [
        { "fieldId": "postalLine1", "label": "Postal Address Line 1", "dataType": "Text", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "postalLine2", "label": "Postal Address Line 2", "dataType": "Text", "isRequired": false, "displayOrder": 20 },
        { "fieldId": "postalSuburb", "label": "Suburb / District", "dataType": "Text", "isRequired": true, "displayOrder": 30 },
        { "fieldId": "postalCity", "label": "City / Town", "dataType": "Text", "isRequired": true, "displayOrder": 40 },
        { "fieldId": "postalCode", "label": "Postal Code", "dataType": "Text", "isRequired": true, "displayOrder": 50, "validationRegex": "^[0-9]{4}$", "regexFailureMessage": "South African postal code is 4 digits." },
        { "fieldId": "postalCountry", "label": "Country", "dataType": "Text", "isRequired": true, "displayOrder": 60, "defaultValue": "South Africa" }
      ]
    },
    {
      "sectionId": "bank-details",
      "displayName": "Bank Details",
      "displayOrder": 110,
      "isAlwaysVisible": true,
      "fields": [
        { "fieldId": "bankAccountHolder", "label": "Account Holder Name", "dataType": "Text", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "bankName", "label": "Bank Name", "dataType": "Text", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "bankBranchCode", "label": "Branch Code", "dataType": "Text", "isRequired": true, "displayOrder": 30, "validationRegex": "^[0-9]{6}$", "regexFailureMessage": "Branch code is 6 digits." },
        { "fieldId": "bankAccountNumber", "label": "Account Number", "dataType": "Text", "isRequired": true, "displayOrder": 40 },
        { "fieldId": "bankAccountType", "label": "Account Type", "dataType": "SingleChoice", "isRequired": true, "displayOrder": 50, "choices": ["Cheque/Current", "Savings", "Transmission"] }
      ]
    },
    {
      "sectionId": "donations",
      "displayName": "Donations to Approved PBO (s18A)",
      "displayOrder": 120,
      "visibilityRule": {
        "conditions": [{ "questionId": "had-donations", "operator": "Equals", "expectedValue": "Yes" }]
      },
      "fields": [
        { "fieldId": "pboName", "label": "PBO Name", "dataType": "Text", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "pboNumber", "label": "PBO Reference Number", "dataType": "Text", "isRequired": true, "displayOrder": 20, "validationRegex": "^930[0-9]{6}$", "regexFailureMessage": "PBO numbers start with 930 and are 9 digits long." },
        { "fieldId": "donationAmount", "label": "Donation amount (4011)", "dataType": "Currency", "isRequired": true, "displayOrder": 30 }
      ]
    },
    {
      "sectionId": "capital-gains",
      "displayName": "Capital Gain / Loss (Local)",
      "displayOrder": 130,
      "visibilityRule": {
        "conditions": [{ "questionId": "had-capital-gain", "operator": "Equals", "expectedValue": "Yes" }]
      },
      "fields": [
        { "fieldId": "cgAssetDescription", "label": "Asset description", "dataType": "Text", "isRequired": true, "displayOrder": 10 },
        { "fieldId": "cgDisposalDate", "label": "Disposal date", "dataType": "Date", "isRequired": true, "displayOrder": 20 },
        { "fieldId": "cgProceeds", "label": "Proceeds", "dataType": "Currency", "isRequired": true, "displayOrder": 30 },
        { "fieldId": "cgBaseCost", "label": "Base cost", "dataType": "Currency", "isRequired": true, "displayOrder": 40 },
        { "fieldId": "cgGainLoss", "label": "Capital Gain / (Loss)", "dataType": "Currency", "isRequired": false, "displayOrder": 50, "helperText": "Calculated automatically from Proceeds minus Base cost." }
      ]
    }
  ]
}
