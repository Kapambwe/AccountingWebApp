            "name": "Compare Usage",
            "action": {
              "actionType": "CreateRecord",
              "entityType": "AuditLog",
              "fieldMappings": {
                "Module": "Operations",
                "Action": "Fuel Reconciliation",
                "Status": "Pending Review"
              }
            }
          },
          {
            "stepNumber": 3,
            "stepType": "Action",
            "name": "Alert Supervisor",
            "action": {
              "actionType": "SendNotification",
              "parameters": { "Channel": "Email", "Recipient": "fleet-manager@company.com" }
            }
          }
        ]
      }
