      "templateDefinition": {
        "name": "Fuel Usage Reconciliation",
        "description": "Compare fuel spend with fleet usage",
        "category": "Operations",
        "trigger": {
          "triggerType": "Schedule",
          "scheduleType": "Weekly",
          "cronExpression": "0 7 * * 1"
        },
        "steps": [
          {
            "stepNumber": 1,
            "stepType": "Action",
            "name": "Load Fuel Purchases",
            "action": {
              "actionType": "RunReport",
