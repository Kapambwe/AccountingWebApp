{
  "templates": [
    {
      "id": 1,
      "name": "Invoice Approval Workflow",
      "description": "Automated approval process for invoices above a certain threshold with multi-level approval",
      "category": "Accounts Receivable",
      "industry": "General",
      "iconName": "fact_check",
      "iconColor": "#3b82f6",
      "isFeatured": true,
      "isRecommended": true,
      "usageCount": 245,
      "rating": 4.8,
      "tags": ["approval", "invoice", "automation"],
      "templateDefinition": {
        "name": "Invoice Approval Workflow",
        "description": "Automatic approval routing for invoices",
        "category": "Accounting",
        "trigger": {
          "triggerType": "Event",
          "eventType": "InvoiceCreated",
          "conditions": [
            { "field": "Amount", "operator": "GreaterThan", "value": "1000", "valueType": "Number" }
          ]
        },
        "steps": [
          {
            "stepNumber": 1,
            "stepType": "Condition",
            "name": "Check Amount",
            "conditions": [
              { "field": "Amount", "operator": "GreaterThan", "value": "10000", "valueType": "Number" }
            ]
          },
          {
            "stepNumber": 2,
            "stepType": "Approval",
            "name": "Manager Approval",
            "approval": {
              "approvalType": "Single",
              "approvers": ["manager@example.com"],
              "timeoutHours": 48
            }
          },
          {
            "stepNumber": 3,
            "stepType": "Action",
            "name": "Send Notification",
            "action": {
              "actionType": "SendEmail",
              "emailTo": "{InvoiceCreator}",
              "emailSubject": "Invoice Approved",
              "emailBody": "Your invoice #{InvoiceNumber} has been approved."
            }
          }
        ]
      }
    },
    {
      "id": 2,
      "name": "Automated Payment Reminders",
      "description": "Send automatic reminders to customers with overdue invoices",
      "category": "Accounts Receivable",
      "industry": "General",
      "iconName": "notifications_active",
      "iconColor": "#f59e0b",
      "isFeatured": true,
      "isRecommended": true,
      "usageCount": 189,
      "rating": 4.6,
      "tags": ["reminder", "payment", "collections"],
      "templateDefinition": {
        "name": "Payment Reminder Workflow",
        "description": "Automated reminder for overdue payments",
        "category": "Accounting",
        "trigger": {
          "triggerType": "Schedule",
          "scheduleType": "Daily",
          "cronExpression": "0 9 * * *"
        },
        "steps": [
          {
            "stepNumber": 1,
            "stepType": "Action",
            "name": "Find Overdue Invoices",
            "action": {
              "actionType": "RunReport",
              "parameters": { "ReportType": "OverdueInvoices", "DaysPastDue": 7 }
            }
          },
          {
            "stepNumber": 2,
            "stepType": "Action",
            "name": "Send Reminder Email",
            "action": {
              "actionType": "SendEmail",
              "emailTo": "{CustomerEmail}",
              "emailSubject": "Payment Reminder: Invoice #{InvoiceNumber}",
              "emailTemplate": "PaymentReminder"
            }
          }
        ]
      }
    },
    {
      "id": 3,
      "name": "Expense Report Approval",
      "description": "Multi-level approval process for employee expense reports",
      "category": "Accounts Payable",
      "industry": "General",
      "iconName": "receipt_long",
      "iconColor": "#10b981",
      "isFeatured": true,
      "isRecommended": false,
      "usageCount": 156,
      "rating": 4.7,
      "tags": ["expense", "approval", "reimbursement"],
      "templateDefinition": {
        "name": "Expense Report Approval",
        "description": "Approve employee expense reports",
        "category": "Accounting",
        "trigger": {
          "triggerType": "Event",
          "eventType": "ExpenseReportSubmitted"
        },
        "steps": [
          {
            "stepNumber": 1,
            "stepType": "Approval",
            "name": "Manager Approval",
            "approval": {
              "approvalType": "Single",
              "approvers": ["{EmployeeManager}"],
              "timeoutHours": 48,
              "timeoutAction": "Escalate",
              "escalateTo": "director@example.com"
            }
          },
          {
            "stepNumber": 2,
            "stepType": "Condition",
            "name": "Check Amount",
            "conditions": [
              { "field": "TotalAmount", "operator": "GreaterThan", "value": "500", "valueType": "Number" }
            ]
          },
          {
            "stepNumber": 3,
            "stepType": "Approval",
            "name": "Finance Approval",
            "approval": {
              "approvalType": "Single",
              "approvers": ["finance@example.com"],
              "timeoutHours": 24
            }
          },
          {
            "stepNumber": 4,
            "stepType": "Action",
            "name": "Process Reimbursement",
            "action": {
              "actionType": "CreateRecord",
              "entityType": "Payment",
              "fieldMappings": {
                "EmployeeId": "{EmployeeId}",
                "Amount": "{TotalAmount}",
                "PaymentType": "Reimbursement"
              }
            }
          }
        ]
      }
    },
    {
      "id": 4,
      "name": "Customer Onboarding Workflow",
      "description": "Automated onboarding process for new customers with welcome emails and setup tasks",
      "category": "CRM",
      "industry": "General",
      "iconName": "person_add",
      "iconColor": "#8b5cf6",
      "isFeatured": true,
      "isRecommended": true,
      "usageCount": 134,
      "rating": 4.5,
      "tags": ["onboarding", "customer", "automation"],
      "templateDefinition": {
        "name": "Customer Onboarding",
        "description": "Welcome new customers",
        "category": "CRM",
        "trigger": {
          "triggerType": "Event",
          "eventType": "CustomerCreated"
        },
        "steps": [
          {
            "stepNumber": 1,
            "stepType": "Action",
            "name": "Send Welcome Email",
            "action": {
              "actionType": "SendEmail",
              "emailTo": "{CustomerEmail}",
              "emailSubject": "Welcome to {CompanyName}!",
              "emailTemplate": "WelcomeEmail"
            }
          },
          {
            "stepNumber": 2,
            "stepType": "Delay",
            "name": "Wait 1 Day",
            "delayMinutes": 1440
          },
          {
            "stepNumber": 3,
            "stepType": "Action",
            "name": "Create Onboarding Task",
            "action": {
              "actionType": "AssignTask",
              "assignedTo": "{AccountManager}",
              "taskType": "Onboarding Call",
              "dueDaysFromNow": 3
            }
          }
        ]
      }
    },
